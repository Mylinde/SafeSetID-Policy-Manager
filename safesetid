# Function to create the self-healing wrapper script
_create_wrapper() {
	_log info "Creating self-healing wrapper at ${WRAPPER_SCRIPT_PATH}"

	cat > "${WRAPPER_SCRIPT_PATH}" <<'WRAPPER_EOF'
#!/bin/bash
set -eu

# This script is a self-healing wrapper for safesetid.
# It verifies the integrity of the data store (/var/lib/safesetid) and the main script.
# If the datastore differs from its stored hash, the wrapper attempts to restore
# the persisted files from the runtime trusted tmpfs store at /var/tmp/safesetid.
# Do not edit this file manually; it's generated by safesetid install_script.

MAIN_SCRIPT="/usr/local/bin/safesetid"
SCRIPT_HASH_FILE="/var/lib/safesetid/safesetid.sha256"
TRUSTED_BACKUP="/var/lib/safesetid/safesetid.bak"
DATA_HASH_FILE="/var/lib/safesetid/datastore.sha256"
TEMP_STORE_DIR="/var/tmp/safesetid"
CONFIG_DIR="/etc/safesetid"

DATA_FILES=(
  "/var/lib/safesetid/uid_allowlist_policy.canonical"
  "/var/lib/safesetid/gid_allowlist_policy.canonical"
  "/var/lib/safesetid/uid.config.canonical"
  "/var/lib/safesetid/gid.config.canonical"
  "/var/lib/safesetid/.uid"
  "/var/lib/safesetid/.gid" 
  "/var/lib/safesetid/safesetid.bak"
  "/var/lib/safesetid/safesetid-wrapper.bak"
  "/var/lib/safesetid/safesetid.sha256"
)

_compute_tmp() {
  local out="$1"
  : >"${out}"
  for f in "${DATA_FILES[@]}"; do
    if [ -f "${f}" ]; then
      sha256sum "${f}" >> "${out}" 2>/dev/null || true
    fi
  done
  sort -u "${out}" -o "${out}" 2>/dev/null || true
}

_ensure_tempdir() {
  # Try to make the TEMP_STORE_DIR available (best-effort).
  if [ -d "${TEMP_STORE_DIR}" ]; then
    return 0
  fi
  mkdir -p "${TEMP_STORE_DIR}" 2>/dev/null || return 1
  chmod 700 "${TEMP_STORE_DIR}" 2>/dev/null || true

  # if already a mountpoint, ok
  if mountpoint -q "${TEMP_STORE_DIR}"; then
    return 0
  fi

  # try to mount tmpfs as fallback (best-effort)
  if mount -t tmpfs -o mode=700,uid=0,gid=0,nodev,noexec,nosuid tmpfs "${TEMP_STORE_DIR}" 2>/dev/null; then
    logger -t safesetid-wrapper -p auth.notice "Mounted tmpfs at ${TEMP_STORE_DIR}"
    return 0
  fi

  return 1
}

# Verify datastore integrity; attempt restore from TEMP_STORE_DIR if mismatch
if [ ! -f "${DATA_HASH_FILE}" ]; then
  echo "CRITICAL: Data hash file not found. Cannot verify data integrity." >&2
  logger -t safesetid-wrapper -p auth.crit "Data hash file ${DATA_HASH_FILE} not found. Halting."
  exit 1
fi

CURRENT_TMP="$(mktemp)" || {
  logger -t safesetid-wrapper -p auth.crit "Failed to create temp file"
  exit 1
}
_compute_tmp "${CURRENT_TMP}"

if ! cmp -s "${DATA_HASH_FILE}" "${CURRENT_TMP}"; then
  # Persist computed list for debugging instead of immediately deleting it
  ts="$(date -u +%Y%m%dT%H%M%SZ)"
  SAVED="/var/lib/safesetid/.datastore_check.${ts}"
  if mv "${CURRENT_TMP}" "${SAVED}" 2>/dev/null; then
    logger -t safesetid-wrapper -p auth.warn "Datastore integrity mismatch detected; saved computed list to ${SAVED}"

    # Show a short summary of differences (up to 50 lines) between stored and computed
    if [ -f "${DATA_HASH_FILE}" ]; then
      # comm requires sorted inputs; limit lines to avoid log flooding
      comm -3 <(sort "${DATA_HASH_FILE}") <(sort "${SAVED}") 2>/dev/null | sed -n '1,50p' | while IFS= read -r line; do
        logger -t safesetid-wrapper -p auth.warn "Datastore diff: ${line}"
      done
    fi
  else
    # Could not persist, keep temp for inspection and log warning
    logger -t safesetid-wrapper -p auth.warn "Datastore integrity mismatch detected; could not persist computed list ${CURRENT_TMP}; keeping it for inspection"
    SAVED="${CURRENT_TMP}"
  fi

  # Only attempt restore from the temp store if it exists or was successfully mounted
  if _ensure_tempdir && [ -d "${TEMP_STORE_DIR}" ]; then
    logger -t safesetid-wrapper -p auth.notice "Attempting restore from temp store ${TEMP_STORE_DIR}."
    for src in "${TEMP_STORE_DIR}"/*; do
      [ -f "${src}" ] || continue
      dst="/var/lib/safesetid/$(basename "${src}")"
      if ! cp -p -- "${src}" "${dst}" 2>/dev/null; then
        logger -t safesetid-wrapper -p auth.err "Failed to restore ${dst} from ${src}"
      else
        chmod 600 "${dst}" 2>/dev/null || true
        chown root:root "${dst}" 2>/dev/null || true
        logger -t safesetid-wrapper -p auth.notice "Restored ${dst} from temp store"
      fi
    done

    # Recompute and verify
    TMP2="$(mktemp)"
    _compute_tmp "${TMP2}"
    if ! cmp -s "${DATA_HASH_FILE}" "${TMP2}"; then
      rm -f "${TMP2}"
      logger -t safesetid-wrapper -p auth.warn "Datastore restore from temp did not fully reconcile the datastore"
      # Note: keep the persisted SAVED file for debugging; it contains the computed snapshot that triggered the mismatch.
    else
      rm -f "${TMP2}"
      logger -t safesetid-wrapper -p auth.notice "Datastore successfully reconciled after restore from temp store"
    fi
  else
    logger -t safesetid-wrapper -p auth.warn "Temp store ${TEMP_STORE_DIR} missing or not mountable; attempting fallback"
  fi
else
  # all good
  rm -f "${CURRENT_TMP}"
fi

# Now verify the main script integrity (as original)
if [ ! -f "${SCRIPT_HASH_FILE}" ] || [ ! -f "${TRUSTED_BACKUP}" ]; then
  echo "CRITICAL: Script hash file or trusted backup not found. Cannot ensure script integrity." >&2
  logger -t safesetid-wrapper -p auth.crit "Script hash or backup file not found. Halting."
  exit 1
fi

# If hash check fails, try to restore from trusted backup (same as before)
if ! sha256sum -c --status "${SCRIPT_HASH_FILE}"; then
  MSG="CRITICAL: Integrity check for ${MAIN_SCRIPT} failed! Attempting to self-heal by restoring the trusted backup."
  echo "${MSG}" >&2
  logger -t safesetid-wrapper -p auth.crit "${MSG}"
  if ! cp -p "${TRUSTED_BACKUP}" "${MAIN_SCRIPT}" 2>/dev/null; then
    MSG_FAIL="FATAL: Self-healing failed. Could not restore ${MAIN_SCRIPT} from backup. MANUAL INTERVENTION REQUIRED."
    echo "${MSG_FAIL}" >&2
    logger -t safesetid-wrapper -p auth.crit "${MSG_FAIL}"
    if command -v notify-send >/dev/null 2>&1; then
      ( export DISPLAY=:0; export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"; notify-send -u critical "Security Alert: safesetid" "${MSG_FAIL}" || true ) &>/dev/null || true
    fi
    exit 1
  fi
  logger -t safesetid-wrapper -p auth.notice "Successfully restored ${MAIN_SCRIPT} from trusted backup."
fi

# Ensure the main script is readable by wrapper; if not readable, try to restore from backup
if [ ! -r "${MAIN_SCRIPT}" ]; then
  logger -t safesetid-wrapper -p auth.warn "${MAIN_SCRIPT} not readable; attempting restore from ${TRUSTED_BACKUP}."
  if cp -p "${TRUSTED_BACKUP}" "${MAIN_SCRIPT}" 2>/dev/null; then
    chown root:root "${MAIN_SCRIPT}" 2>/dev/null || true
    chmod 0755 "${MAIN_SCRIPT}" 2>/dev/null || true
    logger -t safesetid-wrapper -p auth.notice "Restored and fixed perms for ${MAIN_SCRIPT}."
  else
    echo "FATAL: ${MAIN_SCRIPT} not readable and restore failed. Manual intervention required." >&2
    exit 1
  fi
fi

# If file exists and is not executable, do NOT fail — prefer to exec via interpreter.
# But also try to repair permissions so future runs are smooth:
if [ ! -x "${MAIN_SCRIPT}" ]; then
  logger -t safesetid-wrapper -p auth.notice "${MAIN_SCRIPT} not executable; attempting to set +x."
  chmod 0755 "${MAIN_SCRIPT}" 2>/dev/null || logger -t safesetid-wrapper -p auth.warn "Failed to chmod +x ${MAIN_SCRIPT}; will exec via /bin/bash if readable."
fi

# Finally execute the main script. Use interpreter directly to avoid relying on the exec bit.
# Using exec /bin/bash means we succeed even if +x is missing, provided the file is readable.
exec /bin/bash "${MAIN_SCRIPT}" "$@"
WRAPPER_EOF

	chmod 0755 "${WRAPPER_SCRIPT_PATH}"
	chown root:root "${WRAPPER_SCRIPT_PATH}"
	_log info "Wrapper script created successfully."
}

# Create the restore helper script (small, minimal, used by systemd path unit)
_create_restore_helper() {
	_log info "Creating wrapper restore helper at ${RESTORE_HELPER}"

	cat > "${RESTORE_HELPER}" <<'RESTORE_EOF'
#!/bin/bash
set -euo pipefail

TARGET="/usr/local/bin/safesetid-wrapper"
BACKUP="/var/lib/safesetid/safesetid-wrapper.bak"
LOGTAG="safesetid-restore-helper"

# If backup not present, nothing to do
if [ ! -f "${BACKUP}" ]; then
	logger -t "${LOGTAG}" "Trusted wrapper backup ${BACKUP} missing; cannot restore"
	exit 1
fi

# If target missing or differs from backup, copy backup to target
if [ ! -f "${TARGET}" ] || ! cmp -s "${BACKUP}" "${TARGET}" 2>/dev/null; then
	if cp -p -- "${BACKUP}" "${TARGET}" 2>/dev/null; then
		chown root:root "${TARGET}" 2>/dev/null || true
		chmod 0755 "${TARGET}" 2>/dev/null || true
		logger -t "${LOGTAG}" "Restored ${TARGET} from trusted backup ${BACKUP}"
		exit 0
	else
		logger -t "${LOGTAG}" "Failed to restore ${TARGET} from ${BACKUP}"
		exit 1
	fi
else
	# nothing to do
	exit 0
fi
RESTORE_EOF

	chmod 0755 "${RESTORE_HELPER}"
	chown root:root "${RESTORE_HELPER}"
	_log info "Restore helper created at ${RESTORE_HELPER}"
}

install_script() {
    local src
    src="$(readlink -f "${BASH_SOURCE[0]:-$0}")"
    install -m 0755 "${src}" "${MAIN_SCRIPT_PATH}"
    _log info "Script installed to ${MAIN_SCRIPT_PATH}"

    # Initialize base files
    _log info "Initializing base configuration and canonical files..."	
    init

    # Generate uninstall token (32-bit hex) and store it securely
    # Printed once so the admin can store it safely (e.g., password manager)
    local UNINSTALL_TOKEN=""
    if command -v openssl >/dev/null 2>&1; then
        UNINSTALL_TOKEN="$(openssl rand -hex 4 2>/dev/null || true)"
    else
        UNINSTALL_TOKEN="$(dd if=/dev/urandom bs=4 count=1 2>/dev/null | od -An -tx4 | tr -d ' \n')"
    fi
    if [ -n "${UNINSTALL_TOKEN}" ]; then
        printf '%s\n' "${UNINSTALL_TOKEN}" > "${BACKUP_DIR}/.uninstall_token"
        chmod 600 "${BACKUP_DIR}/.uninstall_token" 2>/dev/null || true
        chown root:root "${BACKUP_DIR}/.uninstall_token" 2>/dev/null || true
    else
        _log warning "WARN: could not generate uninstall token"
    fi

    # Create restore helper and its backup if needed
    _create_restore_helper

    # create trusted backup of restore helper as well (optional)
    if [ -f "${RESTORE_HELPER}" ]; then
        cp -p -- "${RESTORE_HELPER}" "${BACKUP_DIR}/safesetid-restore-wrapper.bak" 2>/dev/null || true
        chmod 600 "${BACKUP_DIR}/safesetid-restore-wrapper.bak" 2>/dev/null || true
        chown root:root "${BACKUP_DIR}/safesetid-restore-wrapper.bak" 2>/dev/null || true
    fi

    # Create wrapper and its trusted backup
    _log info "Creating the self-healing wrapper script..."
    _create_wrapper

    # create trusted backup of wrapper
    if [ -f "${WRAPPER_SCRIPT_PATH}" ]; then
        cp -p -- "${WRAPPER_SCRIPT_PATH}" "${WRAPPER_TRUSTED_BACKUP}" 2>/dev/null || true
        chmod 600 "${WRAPPER_TRUSTED_BACKUP}" 2>/dev/null || true
        chown root:root "${WRAPPER_TRUSTED_BACKUP}" 2>/dev/null || true
    fi

    # Ensure tmpfs temp store and populate it
    _log info "Ensuring tmpfs temp store and populating it..."
    _ensure_tempfs_mounted || true
    _sync_temp_from_datastore || true
    _update_datastore_hash || true

    # Create trusted backup and its hash for main script
    _log info "Creating trusted backup and canonical hash for self-healing..."
    cp "${MAIN_SCRIPT_PATH}" "${TRUSTED_SCRIPT_BACKUP}"
    chmod 600 "${TRUSTED_SCRIPT_BACKUP}"   # backup only readable by root
    sha256sum "${MAIN_SCRIPT_PATH}" > "${CANON_SCRIPT_HASH_FILE}"
    chmod 644 "${CANON_SCRIPT_HASH_FILE}"   # hash readable for sha256sum -c
    # ensure main script is executable
    chmod 0755 "${MAIN_SCRIPT_PATH}"
    chown root:root "${MAIN_SCRIPT_PATH}" || true

    # Optionally make wrapper, helper and backups immutable if chattr is available
    if command -v chattr >/dev/null 2>&1; then
        _log info "Setting immutable bit on trusted backups, helper and wrapper (chattr +i) to harden against accidental deletion. Root can still remove this."
        # set +i if already set (no-op) then +i
        for f in "${RESTORE_HELPER}" "${WRAPPER_SCRIPT_PATH}" "${WRAPPER_TRUSTED_BACKUP}" "${TRUSTED_SCRIPT_BACKUP}" "${BACKUP_DIR}/safesetid-restore-wrapper.bak"; do
            if [ -f "${f}" ]; then
                # try to remove immutability first to avoid errors on some filesystems
                chattr -i "${f}" 2>/dev/null || true
                chattr +i "${f}" 2>/dev/null || _log warning "WARN: chattr +i failed for ${f}"
            fi
        done
    fi

    # Create wrapper restore systemd units and enable them (done in install_service)
    _log info "Creating the systemd units and enabling services..."
    install_service	
    install_monitor
    install_file_monitor

cat <<EOF

