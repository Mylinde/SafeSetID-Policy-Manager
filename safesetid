	_log info "Full installation complete. Please configure your policies with 'safesetid configure_uid'."
}

uninstall_script() {

	# Advanced security check: Prevent direct execution by a root shell.
	# The command must be invoked via a privilege escalation tool like 'sudo' or 'doas'
	# by a logged-in, non-root user. This acts as a "two-man rule" against an attacker
	# who has already gained a root shell.
	local user="${SUDO_USER:-${DOAS_USER:-}}"

	if [ -z "${user}" ] || [ "${user}" = "root" ]; then
		_log err "SECURITY: Direct root execution of 'uninstall_script' is forbidden."
		_log err "Please run this command as a regular user via 'sudo' or 'doas'."
		return 1
	fi

	# Load uninstall token from BACKUP_DIR
    local stored_token
    if [ -r "${BACKUP_DIR}/.uninstall_token" ]; then
        stored_token="$(tr -d '\n\r' < "${BACKUP_DIR}/.uninstall_token" 2>/dev/null || printf '')"
    else
        _log err "ERROR: uninstall token missing. Aborting."
        return 1
    fi

    # Check if the token (second argument) was provided
    if [ "$#" -lt 2 ]; then
        _log err "ERROR: Missing uninstall token."
        return 1
    fi

    # FIX: Validate token format (8-char hex)
    if [[ ! "$2" =~ ^[0-9a-f]{8}$ ]]; then
        sleep 1  # Rate-limiting
        _log err "ERROR: Invalid token format."
        return 1
    fi

    # FIX: Constant-time comparison (character by character)
    local provided_token="$2"
    local mismatch=0
    local i
    
    # Ensure both tokens are same length
    if [ "${#provided_token}" -ne "${#stored_token}" ]; then
        mismatch=1
    fi
    
    # Compare character by character (always complete loop)
    for ((i=0; i<${#stored_token}; i++)); do
        if [ "${provided_token:i:1}" != "${stored_token:i:1}" ]; then
            mismatch=1
        fi
    done
    
    if [ "${mismatch}" -ne 0 ]; then
        sleep 1  # Rate-limiting against brute-force
        _log err "ERROR: Invalid uninstall token."
        return 1
    fi

    # Interaktive Bestätigung bleibt bestehen
 	# Interactive confirmation to prevent accidental uninstallation.
 	local response
	read -r -p "This will permanently remove safesetid and all its components. Are you absolutely sure? [y/N] " response
	if [[ ! "$response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
		_log info "Uninstall cancelled."
		exit 0
	fi

	# Try to remove immutable bit if present (so deletion is possible)
	if command -v chattr >/dev/null 2>&1; then
		for f in "${WRAPPER_SCRIPT_PATH}" "${WRAPPER_TRUSTED_BACKUP}" "${TRUSTED_SCRIPT_BACKUP}" "${RESTORE_HELPER}" "${BACKUP_DIR}/safesetid-restore-wrapper.bak"; do
			if [ -e "${f}" ]; then
				chattr -i "${f}" 2>/dev/null || true
			fi
		done
	fi

	# remove services and mounts and data
	uninstall_file_monitor
	uninstall_monitor
	uninstall_service

	# Try to unmount tmpfs temp store if mounted
	if mountpoint -q "${TEMP_STORE_DIR}"; then
		umount "${TEMP_STORE_DIR}" 2>/dev/null || true
	fi

	# remove temp dir
	rm -rf "${TEMP_STORE_DIR}" 2>/dev/null || true

	# remove binaries
	rm -f "${MAIN_SCRIPT_PATH}"
	rm -f "${WRAPPER_SCRIPT_PATH}"
	rm -f "${RESTORE_HELPER}"
	rm -fr "${CONFIG_DIR}"
	rm -fr "${BACKUP_DIR}"

	_log info "Script, wrapper, and all related data have been removed."
}

install_service() {
	if ! command -v systemctl >/dev/null 2>&1; then
		_log err "ERROR: systemctl not available; cannot install systemd unit."
		return 1
	fi

	# Create systemd mount unit for tmpfs at /var/tmp/safesetid
	cat >/etc/systemd/system/var-tmp-safesetid.mount <<'MOUNT'
[Unit]
Description=Tmpfs for SafeSetID runtime trusted store
DefaultDependencies=no
Before=local-fs.target
Wants=safesetid.service

[Mount]
What=tmpfs
Where=/var/tmp/safesetid
Type=tmpfs
Options=mode=700,uid=0,gid=0,nodev,noexec,nosuid

[Install]
WantedBy=local-fs.target
MOUNT

	# Create restore path/service units for the wrapper - ensures wrapper is restored if deleted/changed
	cat >/etc/systemd/system/safesetid-wrapper-restore.service <<'UNIT'
[Unit]
Description=Restore safesetid-wrapper from trusted backup
DefaultDependencies=no
After=local-fs.target
[Service]
Type=oneshot
ExecStart=/usr/libexec/safesetid-restore-wrapper
User=root
Group=root
RemainAfterExit=no
UNIT

	cat >/etc/systemd/system/safesetid-wrapper-restore.path <<'UNIT'
[Path]
Unit=safesetid-wrapper-restore.service
PathChanged=/usr/local/bin/safesetid-wrapper

[Install]
WantedBy=multi-user.target
UNIT

	# Create systemd monitor unit for detecting passwd/group changes
	cat >/etc/systemd/system/safesetid-monitor.service <<'UNIT'
[Unit]
Description=Run safesetid on /etc/passwd changes
After=safesetid.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/safesetid-wrapper check_function
User=root
Group=root
NoNewPrivileges=yes
PrivateTmp=yes
RemainAfterExit=no
UNIT

	cat >/etc/systemd/system/safesetid-monitor.path <<'UNIT'
[Path]
Unit=safesetid-monitor.service
PathModified=/etc/passwd
PathModified=/etc/group

[Install]
WantedBy=multi-user.target
UNIT

	# Create systemd file monitor unit for verifying allowlists and configs
	cat >/etc/systemd/system/safesetid-file-monitor.service <<'UNIT'
[Unit]
Description=Verify and apply SafeSetID policies on file changes
After=safesetid.service var-tmp-safesetid.mount
Requires=var-tmp-safesetid.mount

[Service]
Type=oneshot
ExecStart=/usr/local/bin/safesetid-wrapper verify
User=root
Group=root
NoNewPrivileges=yes
PrivateTmp=yes
RemainAfterExit=no
UNIT

	cat >/etc/systemd/system/safesetid-file-monitor.path <<'UNIT'
[Path]
Unit=safesetid-file-monitor.service
PathModified=/sys/kernel/security/safesetid/uid_allowlist_policy
PathModified=/sys/kernel/security/safesetid/gid_allowlist_policy
PathModified=/etc/safesetid/uid.config
PathChanged=/etc/safesetid/uid.config
PathModified=/etc/safesetid/gid.config
PathChanged=/etc/safesetid/gid.config
PathModified=/usr/local/bin/safesetid
PathModified=/usr/local/bin/safesetid-wrapper
PathModified=/usr/libexec/safesetid-restore-wrapper
PathModified=/etc/systemd/system/var-tmp-safesetid.mount
PathChanged=/etc/systemd/system/local-fs.target.wants/var-tmp-safesetid.mount
PathModified=/etc/systemd/system/safesetid.service
PathChanged=/etc/systemd/system/multi-user.target.wants/safesetid.service
PathModified=/etc/systemd/system/safesetid-wrapper-restore.path
PathChanged=/etc/systemd/system/multi-user.target.wants/safesetid-wrapper-restore.path
PathModified=/etc/systemd/system/safesetid-wrapper-restore.service
PathModified=/etc/systemd/system/safesetid-monitor.path
PathChanged=/etc/systemd/system/multi-user.target.wants/safesetid-monitor.path
PathModified=/etc/systemd/system/safesetid-monitor.service
PathModified=/etc/systemd/system/safesetid-file-monitor.path
PathChanged=/etc/systemd/system/multi-user.target.wants/safesetid-file-monitor.path
PathModified=/etc/systemd/system/safesetid-file-monitor.service

[Install]
WantedBy=multi-user.target
UNIT

	# reload systemd to see new unit
	if ! systemctl daemon-reload; then
		_log warning "WARN: systemctl daemon-reload failed"
	fi

	# enable and start the mount so it's available for safesetid.service
	if ! systemctl enable --now var-tmp-safesetid.mount 2>/dev/null; then
		_log warning "WARN: could not enable/start var-tmp-safesetid.mount (falling back to on-demand mount)"
	fi

	# enable and start wrapper restore units
	if ! systemctl enable --now safesetid-wrapper-restore.path 2>/dev/null; then
		_log warning "WARN: could not enable/start safesetid-wrapper-restore.path"
	fi

	# ensure directory exists and perms are set
	mkdir -p "${TEMP_STORE_DIR}" 2>/dev/null || true
	chmod 700 "${TEMP_STORE_DIR}" 2>/dev/null || true

	# create the safesetid.service unit (ensure dependency on mount)
	cat >/etc/systemd/system/safesetid.service <<'UNIT'
[Unit]
Description=Configure SafeSetID policies
After=local-fs.target var-tmp-safesetid.mount safesetid-wrapper-restore.service
Wants=var-tmp-safesetid.mount safesetid-wrapper-restore.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/safesetid-wrapper
User=root
Group=root
NoNewPrivileges=yes
PrivateTmp=yes
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
UNIT

	# reload systemd to pick up service unit
	if ! systemctl daemon-reload; then
		_log err "Failed to reload systemd daemon."
		exit 1
	fi

	# enable and start safesetid.service
	systemctl enable --now safesetid.service || _log warning "WARN: could not enable/start safesetid.service"

	_log info "safesetid.service installed and started (mount unit var-tmp-safesetid.mount and wrapper restore configured)"
}

uninstall_service() {
	# disable and stop safesetid.service
	if command -v systemctl >/dev/null 2>&1; then
		systemctl disable --now safesetid.service || true
	fi

	# disable and stop wrapper restore units and mount unit
	if command -v systemctl >/dev/null 2>&1; then
		systemctl disable --now safesetid-wrapper-restore.path || true
	fi

	# attempt unmount if still mounted
	if mountpoint -q "${TEMP_STORE_DIR}"; then
		umount "${TEMP_STORE_DIR}" 2>/dev/null || true
	fi

	# remove service and mount unit files
	rm -f /etc/systemd/system/safesetid.service
	rm -f /etc/systemd/system/var-tmp-safesetid.mount
	rm -f /etc/systemd/system/safesetid-wrapper-restore.service
	rm -f /etc/systemd/system/safesetid-wrapper-restore.path

	# reload systemd state
	if command -v systemctl >/dev/null 2>&1; then
		systemctl daemon-reload || true
	fi

	_log info "safesetid.service and protector units uninstalled"
}

