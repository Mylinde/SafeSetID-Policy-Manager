	# Internal commands for self-healing and uninstall logic. Not for direct user interaction.
	check_function)
		_ensure_non_interactive
		check_function ;;
	_install_service)
		_ensure_non_interactive
		install_service ;;
	_install_monitor)
		_ensure_non_interactive
		install_monitor ;;
	_install_file_monitor)
		_ensure_non_interactive
