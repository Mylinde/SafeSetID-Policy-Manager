	_uninstall_service)
		_ensure_non_interactive
		uninstall_service ;;
	_uninstall_monitor)
		_ensure_non_interactive
		uninstall_monitor ;;
	_uninstall_file_monitor)
		_ensure_non_interactive
		uninstall_file_monitor ;;
	_monitor_activity_record)
		_ensure_non_interactive
		_monitor_activity_record ;;
	_dos_mitigate)
		_ensure_non_interactive
		_dos_mitigate ;;
	_dos_check_and_mitigate)
