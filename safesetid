#!/bin/bash

# =========================================================================
# SafeSetID Policy Management Script
# This script configures and maintains SafeSetID policies, detects new UIDs
# and restricts them until they were added to the passwd backup file.
# Includes self-healing, tmpfs runtime-trusted store and protector units to
# help ensure wrapper availability.
