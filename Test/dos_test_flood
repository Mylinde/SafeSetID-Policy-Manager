#!/usr/bin/env bash
# filepath: /home/mario/Github/SafeSetID-Policy-Manager/Test/dos_test_flood
# =========================================================================
# SafeSetID DoS Flood Test Script
# 
# Purpose: Simulate denial-of-service attack by frequently modifying
#          /etc/safesetid/* files to test DOS protection mechanisms.
#
# WARNING: This script performs intensive I/O operations.
#          - Run ONLY on test systems
#          - Do NOT modify /etc/passwd or /etc/group on production
#          - Monitor system resources during test
#
# Usage:
#   sudo ./dos_test_flood [-d duration] [-p writers] [-i interval] [--group] [--stop]
#
