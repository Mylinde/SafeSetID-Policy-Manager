# =========================================================================
# Validation Functions
# =========================================================================

_validate_root() {
    if [ "$(id -u)" -ne 0 ]; then
        _log ERROR "This script must be run as root (to write /etc/safesetid/*)"
        _log INFO "Please run: sudo ${SCRIPT_NAME}"
        exit 1
    fi
}

_validate_duration() {
    if ! [[ "${DURATION}" =~ ^[0-9]+$ ]]; then
        _log ERROR "DURATION must be a positive integer: ${DURATION}"
        exit 2
    fi
    
    if [ "${DURATION}" -gt "${MAX_DURATION}" ]; then
        _log ERROR "DURATION too high: ${DURATION}s (max: ${MAX_DURATION}s)"
        _log INFO "This limit prevents accidental system overload"
        exit 2
    fi
    
    if [ "${DURATION}" -lt 1 ]; then
        _log ERROR "DURATION too low: ${DURATION}s (min: 1s)"
        exit 2
    fi
}

_validate_parallel() {
    if ! [[ "${PARALLEL}" =~ ^[0-9]+$ ]]; then
        _log ERROR "PARALLEL must be a positive integer: ${PARALLEL}"
        exit 2
    fi
    
    if [ "${PARALLEL}" -gt "${MAX_PARALLEL}" ]; then
        _log ERROR "PARALLEL too high: ${PARALLEL} (max: ${MAX_PARALLEL})"
        _log INFO "This limit prevents fork bomb scenarios"
        exit 2
    fi
    
    if [ "${PARALLEL}" -lt 1 ]; then
        _log ERROR "PARALLEL too low: ${PARALLEL} (min: 1)"
        exit 2
    fi
}

_validate_interval() {
    # Check if INTERVAL is a valid float using awk
    if ! awk -v i="${INTERVAL}" 'BEGIN {exit !(i > 0)}' 2>/dev/null; then
        _log ERROR "INTERVAL must be a positive number: ${INTERVAL}"
        exit 2
    fi
    
    # Check minimum interval
    if awk -v i="${INTERVAL}" -v m="${MIN_INTERVAL}" 'BEGIN {exit !(i < m)}' 2>/dev/null; then
        _log ERROR "INTERVAL too low: ${INTERVAL}s (min: ${MIN_INTERVAL}s)"
        _log INFO "This limit prevents system overload (max ${PARALLEL} writers * $(awk "BEGIN {print 1/${MIN_INTERVAL}}") writes/s)"
        exit 2
    fi
}

_validate_files() {
    local file
    for file in "${FILES[@]}"; do
        local dir
        dir="$(dirname "${file}")"
        
        # Check if parent directory exists or can be created
        if [ ! -d "${dir}" ]; then
            if ! mkdir -p "${dir}" 2>/dev/null; then
                _log ERROR "Cannot create directory: ${dir}"
                exit 2
            fi
        fi
        
        # Check if file exists or can be created
        if [ ! -f "${file}" ]; then
            if ! touch "${file}" 2>/dev/null; then
                _log ERROR "Cannot create file: ${file}"
                exit 2
            fi
        fi
        
        # Check write permission
        if [ ! -w "${file}" ]; then
            _log ERROR "File not writable: ${file}"
            exit 2
        fi
    done
}

# =========================================================================
# Cleanup & Signal Handling
# =========================================================================

_cleanup() {
    local exit_code="${1:-0}"
    
    _log INFO "Cleaning up..."
    
    # Kill all writer processes
    if [ -f "${PIDFILE}" ]; then
        while read -r pid; do
            [ -n "${pid}" ] || continue
            if kill -0 "${pid}" 2>/dev/null; then
                _log INFO "Stopping writer PID ${pid}..."
                kill "${pid}" 2>/dev/null || true
                sleep 0.2
                # Force kill if still alive
                if kill -0 "${pid}" 2>/dev/null; then
                    kill -KILL "${pid}" 2>/dev/null || true
                fi
            fi
        done < "${PIDFILE}"
        rm -f "${PIDFILE}"
    fi
    
    # Also kill by process name (catch orphans)
    pkill -f "_writer_main" 2>/dev/null || true
    
    # Remove lock
    if [ -f "${LOCKFILE}" ]; then
        rm -f "${LOCKFILE}"
    fi
    
    _log INFO "Cleanup complete"
    exit "${exit_code}"
}

# Trap signals for graceful cleanup
trap '_cleanup 130' SIGINT SIGTERM
trap '_cleanup 0' EXIT

# =========================================================================
# Writer Worker Function
# =========================================================================

_writer_main() {
    local worker_id="$1"
    local interval="$2"
    shift 2
    local files=("$@")
    
    _log INFO "Writer ${worker_id} started (PID=$$, interval=${interval}s)"
    
    local write_count=0
    
    while true; do
        local timestamp rand content file tmp
        
        # Generate timestamp and random data
        timestamp="$(date -u '+%Y%m%dT%H%M%SZ')"
        rand="$(head -c 6 /dev/urandom 2>/dev/null | od -A n -t x1 | tr -d ' \n' || echo "NORANDOM")"
        content="${timestamp} writer-${worker_id} random=${rand} count=${write_count}"
        
        # Write to all files atomically
        for file in "${files[@]}"; do
            # Create temp file in /tmp (not in /etc/)
            tmp="$(mktemp -p /tmp "dos_flood.XXXXXX" 2>/dev/null)" || {
                _log WARN "Writer ${worker_id}: mktemp failed for ${file}"
                continue
            }
            
            # Secure temp file
            chmod 600 "${tmp}" 2>/dev/null || true
            
            # Write content
            if printf '%s\n' "${content}" > "${tmp}" 2>/dev/null; then
                # Atomic move (even cross-device)
                if mv -f "${tmp}" "${file}" 2>/dev/null; then
                    : # Success
                else
                    # Fallback: copy and remove
                    if cat "${tmp}" > "${file}" 2>/dev/null; then
                        rm -f "${tmp}" 2>/dev/null || true
                    else
                        _log WARN "Writer ${worker_id}: failed to write ${file}"
                        rm -f "${tmp}" 2>/dev/null || true
                    fi
                fi
            else
                _log WARN "Writer ${worker_id}: failed to write to temp file"
                rm -f "${tmp}" 2>/dev/null || true
            fi
        done
        
        write_count=$((write_count + 1))
        
        # Sleep between writes
        sleep "${interval}"
    done
}

# =========================================================================
# Stop Running Flood
# =========================================================================

_stop_flood() {
    _log INFO "Stopping running flood test..."
    
    if [ ! -f "${PIDFILE}" ]; then
        _log WARN "No PID file found at: ${PIDFILE}"
        _log INFO "No flood test appears to be running"
        exit 0
    fi
    
    local stopped_count=0
    
    while read -r pid; do
        [ -n "${pid}" ] || continue
        
        if ! [[ "${pid}" =~ ^[0-9]+$ ]]; then
            _log WARN "Invalid PID in file: ${pid}"
            continue
        fi
        
        if kill -0 "${pid}" 2>/dev/null; then
            _log INFO "Stopping writer PID ${pid}..."
            if kill "${pid}" 2>/dev/null; then
                stopped_count=$((stopped_count + 1))
                # Wait for graceful shutdown
                local timeout=5
                while [ "${timeout}" -gt 0 ] && kill -0 "${pid}" 2>/dev/null; do
                    sleep 0.5
                    timeout=$((timeout - 1))
                done
                # Force kill if still alive
                if kill -0 "${pid}" 2>/dev/null; then
                    _log WARN "Force killing PID ${pid}"
                    kill -KILL "${pid}" 2>/dev/null || true
                fi
            else
                _log WARN "Failed to kill PID ${pid}"
            fi
        fi
    done < "${PIDFILE}"
    
    rm -f "${PIDFILE}"
    _log INFO "Stopped ${stopped_count} writer(s)"
    exit 0
}

# =========================================================================
# Main Flood Test Logic
# =========================================================================

_run_flood_test() {
    _print_banner
    
    # Show configuration
    _log INFO "Test Configuration:"
    _log INFO "  Duration:         ${DURATION} seconds"
    _log INFO "  Parallel Writers: ${PARALLEL}"
    _log INFO "  Write Interval:   ${INTERVAL} seconds"
    _log INFO "  Target Files:     ${#FILES[@]} file(s)"
    
    for file in "${FILES[@]}"; do
        _log INFO "    - ${file}"
    done
    
    # Calculate expected load
    local writes_per_second
    writes_per_second="$(awk -v p="${PARALLEL}" -v i="${INTERVAL}" 'BEGIN {printf "%.1f", p/i}')"
    local total_writes
    total_writes="$(awk -v d="${DURATION}" -v w="${writes_per_second}" 'BEGIN {printf "%.0f", d*w}')"
    
    _log INFO "Expected Load:"
    _log INFO "  Writes/second:    ${writes_per_second}"
    _log INFO "  Total writes:     ${total_writes}"
    
    # Check for existing flood test
    if [ -f "${PIDFILE}" ]; then
        _log ERROR "Another flood test is already running (PID file exists)"
        _log INFO "Stop it first with: sudo ${SCRIPT_NAME} --stop"
        exit 1
    fi
    
    # Acquire lock to prevent concurrent tests
    if command -v flock >/dev/null 2>&1; then
        exec 200>"${LOCKFILE}"
        if ! flock -n 200; then
            _log ERROR "Another instance is already running (lock held)"
            exit 1
        fi
    fi
    
    # Ensure target files exist with safe permissions
    _log INFO "Preparing target files..."
    for file in "${FILES[@]}"; do
        local dir
        dir="$(dirname "${file}")"
        mkdir -p "${dir}" 2>/dev/null || true
        touch "${file}" 2>/dev/null || true
        chown root:root "${file}" 2>/dev/null || true
        chmod 600 "${file}" 2>/dev/null || true
    done
    
    # Spawn writer processes
    _log INFO "Spawning ${PARALLEL} writer process(es)..."
    rm -f "${PIDFILE}"
    
    local pids=()
    local i
    for i in $(seq 1 "${PARALLEL}"); do
        # Start writer in background
        _writer_main "${i}" "${INTERVAL}" "${FILES[@]}" &
        local pid=$!
        echo "${pid}" >> "${PIDFILE}"
        pids+=("${pid}")
        _log INFO "Spawned writer #${i} (PID=${pid})"
    done
    
    _log INFO "All writers started. Test running for ${DURATION} seconds..."
    _log INFO "Monitor logs: journalctl -t safesetid -t safesetid-wrapper -f"
    
    # Wait for duration
    local elapsed=0
    while [ "${elapsed}" -lt "${DURATION}" ]; do
        sleep 1
        elapsed=$((elapsed + 1))
        
        # Progress indicator every 10 seconds
        if [ $((elapsed % 10)) -eq 0 ]; then
            _log INFO "Progress: ${elapsed}/${DURATION} seconds ($(awk -v e="${elapsed}" -v d="${DURATION}" 'BEGIN {printf "%.0f", (e/d)*100}')%)"
        fi
    done
    
    _log INFO "Duration expired. Stopping writers..."
    
    # Stop all writers
    for pid in "${pids[@]}"; do
        if kill -0 "${pid}" 2>/dev/null; then
            kill "${pid}" 2>/dev/null || true
            sleep 0.5
            # Force kill if needed
            if kill -0 "${pid}" 2>/dev/null; then
                kill -KILL "${pid}" 2>/dev/null || true
            fi
        fi
    done
    
    rm -f "${PIDFILE}"
    
    cat <<'RESULTS'

╔═══════════════════════════════════════════════════════════════════════╗
║                        TEST COMPLETED                                 ║
╚═══════════════════════════════════════════════════════════════════════╝

RESULTS:
    Check SafeSetID logs for DOS protection behavior:
    
    # Recent logs
    journalctl -t safesetid -t safesetid-wrapper --since "5 minutes ago" --no-pager
    
    # Follow live logs
    journalctl -t safesetid -t safesetid-wrapper -f
    
    # Check for DOS mitigation
    journalctl -t safesetid --since "5 minutes ago" | grep -i "dos"

EXPECTED BEHAVIOR:
    ✓ DOS protection should trigger after threshold exceeded
    ✓ Mitigation should prevent check_function during active period
    ✓ System should remain responsive throughout test
    ✓ No kernel panics or crashes

RESULTS
    
    _log INFO "Test script log saved to: ${LOGFILE}"
}

# =========================================================================
# Argument Parsing
# =========================================================================

while [ "$#" -gt 0 ]; do
    case "$1" in
        -d|--duration)
            if [ -z "${2:-}" ]; then
                _log ERROR "Option -d requires an argument"
                exit 2
            fi
            DURATION="$2"
            shift 2
            ;;
        -p|--parallel)
            if [ -z "${2:-}" ]; then
                _log ERROR "Option -p requires an argument"
                exit 2
            fi
            PARALLEL="$2"
            shift 2
            ;;
        -i|--interval)
            if [ -z "${2:-}" ]; then
                _log ERROR "Option -i requires an argument"
                exit 2
            fi
            INTERVAL="$2"
            shift 2
            ;;
        --group)
            USE_GROUP=1
            shift
            ;;
        --stop)
            ACTION="stop"
            shift
            ;;
        -h|--help)
            _print_usage
            exit 0
            ;;
        *)
            _log ERROR "Unknown argument: $1"
            _print_usage
            exit 2
            ;;
    esac
done

