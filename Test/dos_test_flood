set -euo pipefail
umask 027
PATH='/usr/sbin:/usr/bin:/sbin:/bin'
export PATH LC_ALL=C LANG=C

# =========================================================================
# Configuration & Constants
# =========================================================================

readonly SCRIPT_NAME="$(basename "$0")"
readonly PIDFILE="/var/run/dos_test_flood.pids"
readonly LOCKFILE="/var/run/dos_test_flood.lock"
readonly LOGFILE="/var/log/dos_test_flood.log"

# Default parameters
DURATION=30
PARALLEL=2
INTERVAL=0.2
USE_GROUP=0
ACTION="run"

# Safety limits (prevent accidental system overload)
readonly MAX_DURATION=300      # 5 minutes max
readonly MAX_PARALLEL=50       # 50 writers max
readonly MIN_INTERVAL=0.05     # 50ms minimum interval

# Files to modify (default: only safesetid configs)
FILES=(/etc/safesetid/uid.config /etc/safesetid/gid.config)

# =========================================================================
# Logging & Utilities
# =========================================================================

_log() {
    local level="$1"
    shift
    local msg="$*"
    local timestamp
    timestamp="$(date -u '+%Y-%m-%d %H:%M:%S UTC')"
    
    # Log to file
    printf '[%s] [%s] %s\n' "${timestamp}" "${level}" "${msg}" >> "${LOGFILE}" 2>/dev/null || true
    
    # Also print to console
    case "${level}" in
        ERROR)
            echo "❌ ERROR: ${msg}" >&2
            ;;
        WARN)
            echo "⚠️  WARN: ${msg}" >&2
            ;;
        INFO)
            echo "ℹ️  INFO: ${msg}"
            ;;
        *)
            echo "${msg}"
            ;;
    esac
}

